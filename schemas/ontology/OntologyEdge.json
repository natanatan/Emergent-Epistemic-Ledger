{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OntologyEdge",
  "description": "An explicit, stored edge. Every edge records the event that created it.",
  "type": "object",
  "required": [
    "originating_event",
    "relation",
    "source",
    "target"
  ],
  "properties": {
    "originating_event": {
      "$ref": "#/definitions/Hash"
    },
    "relation": {
      "$ref": "#/definitions/RelationType"
    },
    "source": {
      "$ref": "#/definitions/ObjectId"
    },
    "target": {
      "$ref": "#/definitions/ObjectId"
    }
  },
  "definitions": {
    "Hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ObjectId": {
      "description": "A typed reference to any protocol object.",
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ObjectKind"
        }
      }
    },
    "ObjectKind": {
      "description": "Kind of object an [`ObjectId`] points to.",
      "type": "string",
      "enum": [
        "claim",
        "evidence",
        "objection",
        "replication",
        "artifact",
        "validation",
        "simulation_job",
        "simulation_result",
        "research_request",
        "research_result",
        "xchange_asset",
        "branch",
        "identity"
      ]
    },
    "RelationType": {
      "description": "Typed relation between two objects in the ontology graph.",
      "type": "string",
      "enum": [
        "DEPENDS_ON",
        "SUPPORTS",
        "CONTRADICTS",
        "REFINES",
        "SUPERSEDES",
        "REPLICATES",
        "FALSIFIES",
        "IMPLEMENTS",
        "DERIVES_FROM",
        "GENERALIZES",
        "SPECIALIZES",
        "ALTERNATIVE_TO",
        "OBSERVES",
        "PREDICTS",
        "USES_DATA_FROM"
      ]
    }
  }
}
