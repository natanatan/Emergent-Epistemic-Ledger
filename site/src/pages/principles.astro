---
import Base from '../layouts/Base.astro';

const principles = [
  ['Ledger consensus is not truth consensus.', 'The ledger secures who said what, when, and that it was not altered. Whether nature agrees is for evidence and testing to decide.'],
  ['Economic stake cannot purchase epistemic authority.', 'Money, reputation and governance are kept apart, so no one can buy standing for a claim.'],
  ['Evidence can overturn canonical claims.', 'A claim marked canonical is the best-supported current state under stated rules, and it stays open to challenge.'],
  ['Minority branches remain recoverable.', 'Competing models are kept, with their ancestry, and can later displace the incumbent.'],
  ['Falsification is a valuable contribution.', 'Removing an unsupported idea is progress, and a failed experiment counts as work.'],
  ['Replication must be independently attributable.', 'Ten copies from one lab are not ten replications. Independence has to be shown.'],
  ['Provenance cannot be silently rewritten.', 'History is append-only. Corrections are new events that point to what they correct.'],
  ['Scientific claims remain revisable.', 'Every status is provisional and can change when the evidence does.'],
  ['Governance controls procedure, not reality.', 'Shared rules can be voted on. Whether a claim is true cannot.'],
  ['Initial trust may be constituted; enduring trust must be earned.', 'Founding validators start with limited, domain-bounded authority that gives way to reputation earned through verifiable work.'],
];
---
<Base title="Principles" description="The ten founding principles of the Emergent Epistemic Ledger.">
  <p class="kicker">Research constitution</p>
  <h1>Principles</h1>
  <p class="lede">The founding constitution every EEL network starts from. The prototype enforces in code the principles that can be enforced.</p>
  <ol class="principles">
    {principles.map(([title, note]) => (
      <li><strong>{title}</strong><span>{note}</span></li>
    ))}
  </ol>
</Base>
